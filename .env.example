# Chapter 30 of Book 3: every variable this repo's own code and its
# reliable_agents_labs dependency actually read, curated by hand.

# Required: config/models.yaml points "answer_model" at Gemini
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.6-flash

# Required: real local Postgres, Qdrant, Neo4j (see compose.yaml)
DATABASE_URL=postgresql://pkgintel_app:pkgintel_app@localhost:5434/pkgintel_app
QDRANT_URL=http://localhost:6333
NEO4J_URI=bolt://localhost:7688
NEO4J_PASSWORD=

# Required: this app's own real Auth0 API resource, Organizations-based
# (chapter 14)
AUTH0_DOMAIN=
AUTH0_AUDIENCE=https://pkgintel-app.dev/api
AUTH0_ACME_ORG_ID=
AUTH0_GLOBEX_ORG_ID=

# Optional: only needed to run tests/contract/test_auth_live.py
# AUTH0_TEST_CLIENT_ID=
# AUTH0_TEST_CLIENT_SECRET=

# Optional: only needed for real tracing (chapter 16)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3001
